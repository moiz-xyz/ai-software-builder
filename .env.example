# ---- Database / queues / storage (docker compose defaults) ----
DATABASE_URL=postgresql://factory:factory@localhost:5440/factory?schema=public
REDIS_URL=redis://localhost:6390
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=factory-assets
S3_ACCESS_KEY=factory
S3_SECRET_KEY=factory-secret
S3_FORCE_PATH_STYLE=true

# ---- API ----
API_PORT=4100
JWT_SECRET=change-me-in-production
# When true, a customer's "Approve & publish" waits for an admin to approve.
REQUIRE_ADMIN_APPROVAL=false
# Root domain used for customer subdomains: <slug>.ROOT_DOMAIN
ROOT_DOMAIN=localtest.me
# Public URL of the web app (used to build preview / live URLs)
WEB_URL=http://localhost:3100
# IP / host customers point custom domains at (CNAME or A record)
PUBLIC_INGRESS_HOST=ingress.example.com

# ---- Seed admin ----
ADMIN_EMAIL=admin@factory.local
ADMIN_PASSWORD=Admin123!

# ---- Web ----
API_INTERNAL_URL=http://localhost:4100
NEXT_PUBLIC_ROOT_DOMAIN=localtest.me
INTERNAL_TOKEN=change-me-internal
